datasource db {
  provider = "sqlite"
  // Dev: DATABASE_URL="file:./dev.db" in .env (relative to this folder). Production: absolute path outside the release.
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  MEMBER
  VIEWER
}

enum BillStatus {
  PENDING
  PAID
  OVERDUE
}

enum RecurrenceInterval {
  NONE
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  passwordHash        String?
  avatarUrl           String?
  memberships         WalletMember[]
  expenses            Expense[]
  plannedExpenses     PlannedExpense[]
  paidBills           InvoiceBill[]        @relation("PaidByUser")
  activityLogs        ActivityLog[]
  savingsTransactions SavingsTransaction[]
  monthBonuses        MonthBonus[]
  createdAt           DateTime             @default(now())
}

model Wallet {
  id                  String               @id @default(cuid())
  name                String
  currency            String               @default("EUR")
  monthlyBudget       Float                @default(2000.0)
  color               String               @default("#6366f1")
  icon                String               @default("Wallet")
  members             WalletMember[]
  invites             WalletInvite[]
  categories          Category[]
  expenses            Expense[]
  plannedExpenses     PlannedExpense[]
  invoices            InvoiceBill[]
  activityLogs        ActivityLog[]
  savingsBuckets      SavingsBucket[]
  savingsTransactions SavingsTransaction[]
  monthBonuses        MonthBonus[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model WalletMember {
  id       String   @id @default(cuid())
  walletId String
  userId   String
  role     String   @default("MEMBER")
  wallet   Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())
  /// Secret for this member's calendar feed URL (calendar apps cannot send cookies).
  /// Per member, so removing a member revokes their feed; rotated via POST /api/wallets/[id]/calendar-token.
  calendarToken String? @unique

  @@unique([walletId, userId])
}

model WalletInvite {
  id          String    @id @default(cuid())
  walletId    String
  code        String    @unique
  role        String    @default("MEMBER")
  targetEmail String?
  status      String    @default("PENDING")
  wallet      Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  expiresAt   DateTime?
  maxUses     Int?
  usedCount   Int       @default(0)
  createdAt   DateTime  @default(now())
}

model Category {
  id              String           @id @default(cuid())
  walletId        String
  name            String
  icon            String           @default("Tag")
  color           String           @default("#3b82f6")
  monthlyLimit    Float?
  wallet          Wallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  expenses        Expense[]
  plannedExpenses PlannedExpense[]
  invoices        InvoiceBill[]
}

model Expense {
  id                  String               @id @default(cuid())
  walletId            String
  userId              String
  categoryId          String?
  invoiceId           String?
  title               String
  amount              Float
  date                DateTime             @default(now())
  notes               String?
  savingsFundedAmount Float                @default(0)
  isRecurring         Boolean              @default(false)
  wallet              Wallet               @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId], references: [id])
  category            Category?            @relation(fields: [categoryId], references: [id])
  invoice             InvoiceBill?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  plannedSource       PlannedExpense?
  savingsTransactions SavingsTransaction[]
  createdAt           DateTime             @default(now())
}

model InvoiceBill {
  id                 String    @id @default(cuid())
  walletId           String
  userId             String
  categoryId         String?
  title              String
  amount             Float
  type               String    @default("BILL")
  dueDate            DateTime
  status             String    @default("PENDING")
  isRecurring        Boolean   @default(false)
  recurrenceInterval String    @default("NONE")
  reminderDaysBefore Int       @default(3)
  invoiceNumber      String?
  notes              String?
  paidAt             DateTime?
  paidByUserId       String?
  /// Stable id shared by every occurrence of one recurring bill/subscription (roll-forward copies it).
  seriesId           String    @default(cuid())
  wallet             Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  category           Category? @relation(fields: [categoryId], references: [id])
  paidByUser         User?     @relation("PaidByUser", fields: [paidByUserId], references: [id])
  expenses           Expense[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([walletId, seriesId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  walletId  String
  userId    String
  action    String
  details   String
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  timestamp DateTime @default(now())
}

model PlannedExpense {
  id                  String               @id @default(cuid())
  walletId            String
  userId              String
  categoryId          String?
  title               String
  amount              Float
  expectedDate        DateTime
  trackFromMonth      String?
  notes               String?
  status              String               @default("PENDING")
  savingsBucketId     String?
  realizedExpenseId   String?              @unique
  wallet              Wallet               @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId], references: [id])
  category            Category?            @relation(fields: [categoryId], references: [id])
  realizedExpense     Expense?             @relation(fields: [realizedExpenseId], references: [id], onDelete: SetNull)
  savingsBucket       SavingsBucket?       @relation(fields: [savingsBucketId], references: [id], onDelete: SetNull)
  savingsTransactions SavingsTransaction[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([walletId, expectedDate])
  @@index([savingsBucketId])
}

model SavingsBucket {
  id              String               @id @default(cuid())
  walletId        String
  kind            String               @default("GOAL") // GENERAL | GOAL
  name            String
  color           String               @default("#10b981")
  icon            String               @default("PiggyBank")
  status          String               @default("ACTIVE") // ACTIVE | CLOSED
  closedAt        DateTime?
  wallet          Wallet               @relation(fields: [walletId], references: [id], onDelete: Cascade)
  plannedExpenses PlannedExpense[]
  transactions    SavingsTransaction[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([walletId, status])
}

// Append-only ledger; bucket balance = sum(amount). See src/lib/savings.ts for types and sign conventions.
model SavingsTransaction {
  id               String          @id @default(cuid())
  walletId         String
  bucketId         String
  userId           String
  type             String // DEPOSIT | TRANSFER_IN | TRANSFER_OUT | EXPENSE_DRAW | BUDGET_BOOST | ADJUSTMENT_IN | ADJUSTMENT_OUT
  amount           Float
  date             DateTime
  transferGroupId  String?
  plannedExpenseId String?
  expenseId        String?
  note             String?
  wallet           Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  bucket           SavingsBucket   @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id])
  plannedExpense   PlannedExpense? @relation(fields: [plannedExpenseId], references: [id], onDelete: SetNull)
  expense          Expense?        @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())

  @@index([walletId, date])
  @@index([bucketId])
}

// Extra budget for one month (outside money: bonus, gift...). Not an Expense, not a savings movement.
model MonthBonus {
  id        String   @id @default(cuid())
  walletId  String
  userId    String
  monthKey  String // YYYY-MM
  amount    Float
  label     String?
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([walletId, monthKey])
}
